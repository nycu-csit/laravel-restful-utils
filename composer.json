{
    "name": "nycu-csit/laravel-restful-utils",
    "description": "Restful API utilities for Laravel projects",
    "keywords": ["Laravel"],
    "homepage": "https://github.com/nycu-csit/laravel-restful-utils",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NycuCsit\\LaravelRestfulUtils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Shih-Tse Chang",
            "email": "stchang@it.cs.nycu.edu.tw"
        }
    ],
    "require": {
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0",
        "php": ">=8.2"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NycuCsit\\LaravelRestfulUtils\\RestfulUtilServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    }
}
